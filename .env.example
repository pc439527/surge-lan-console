# Optional console update check.
# Leave all update-source values empty to show "更新源未配置" in Settings.

# Private/public GitHub repository mode (owner/repo).
SLC_UPDATE_GITHUB_REPO=
SLC_UPDATE_GITHUB_TOKEN=
SLC_UPDATE_BRANCH=main
SLC_UPDATE_CACHE_MINUTES=10

# Alternative manifest mode. When set, it takes precedence over GitHub mode.
# Expected JSON fields: version, commit, branch?, publishedAt?, url?
SLC_UPDATE_MANIFEST_URL=
