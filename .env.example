# Build identity used by Docker Compose.
APP_VERSION=0.5.0
GIT_COMMIT=unknown
GIT_BRANCH=unknown

# Session lifetime. Compose fixes Core host/port/data directory internally.
SLC_SESSION_IDLE_MINUTES=30
SLC_SESSION_ABSOLUTE_HOURS=12

# Optional update check. Leave both sources empty to disable it.
SLC_UPDATE_GITHUB_REPO=
SLC_UPDATE_GITHUB_TOKEN=
SLC_UPDATE_BRANCH=main
SLC_UPDATE_CACHE_MINUTES=10

# Alternative manifest mode; takes precedence over GitHub mode.
SLC_UPDATE_MANIFEST_URL=
